# GTM GURU Lark Bridge Bot configuration
# Copy this file to .env in your deployment environment and fill in secret values there.

# Lark app credentials
LARK_APP_ID=cli_aa0509c988f85cfd
LARK_APP_SECRET=<set-in-secret-manager-do-not-commit>

# Lark event subscription security
LARK_VERIFICATION_TOKEN=<copy-from-event-subscriptions-page>
LARK_ENCRYPT_KEY=<copy-from-event-subscriptions-page-if-enabled>

# Optional extra inbound protection if your gateway can inject this header:
# Authorization: Bearer <BRIDGE_INBOUND_TOKEN>, X-Bridge-Token, or ?bridge_token=
BRIDGE_INBOUND_TOKEN=<optional-shared-token>
BRIDGE_SECRET_TOKEN=<optional-shared-token-alias>

# Routing
BUYER_GTM_GROUP_ID=oc_8a963e87591fe5023b7da9a7bfa5c9ee
AIME_USER_EMAIL=jackson.guo@bytedance.com
AIME_USER_DISPLAY_NAME=Jackson Guo
AIME_USER_OPEN_ID=ou_82ca1e7acc83296b84930b6dd39951da

# Runtime
LARK_API_BASE=https://open.larksuite.com/open-apis
SQLITE_PATH=/data/bridge_state.sqlite3
PORT=8080
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_MESSAGES=3
